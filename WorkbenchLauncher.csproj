<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WorkbenchLauncher</AssemblyName>
    <RootNamespace>WorkbenchLauncher</RootNamespace>
    <ApplicationIcon>Assets\workbench-icon.ico</ApplicationIcon>
    <Product>工作台</Product>
    <Description>个人工作资源启动台</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\workbench-icon.ico" />
    <None Include="Assets\workbench-icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
