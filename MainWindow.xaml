<Window x:Class="WorkbenchLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="工作台" Icon="Assets/workbench-icon.ico" Width="1320" Height="790" MinWidth="1050" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#F5F6FA" FontFamily="Microsoft YaHei UI">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#151A2D">
            <Grid Margin="22,28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="WORKBENCH" Foreground="White" FontWeight="Bold" FontSize="20"/>
                    <TextBlock Text="我的工作启动台" Foreground="#929AB5" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,38,0,0">
                    <Button x:Name="AllButton" Content="全部资源" Click="Filter_Click" Tag="All" HorizontalContentAlignment="Left" Background="#2C3354" Foreground="White" Margin="0,0,0,8"/>
                    <Button x:Name="FavoriteButton" Content="★  收藏" Click="Filter_Click" Tag="Favorite" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#C5CADB" Margin="0,0,0,8"/>
                    <Button x:Name="RecentButton" Content="◷  最近使用" Click="Filter_Click" Tag="Recent" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#C5CADB"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Margin="0,34,0,0">
                    <TextBlock Text="分类" Foreground="#737C99" FontSize="12" Margin="10,0,0,10"/>
                    <ListBox x:Name="ProjectList" SelectionChanged="ProjectList_SelectionChanged" Background="Transparent" BorderThickness="0" Foreground="#C5CADB" AllowDrop="True" PreviewMouseLeftButtonDown="ProjectList_PreviewMouseLeftButtonDown" PreviewMouseMove="ProjectList_PreviewMouseMove" Drop="ProjectList_Drop">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="ProjectNav" Background="Transparent" CornerRadius="8" Padding="14,8"><TextBlock Text="{Binding}" Foreground="#C5CADB" TextTrimming="CharacterEllipsis"/></Border>
                                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ProjectNav" Property="Background" Value="#222942"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ProjectNav" Property="Background" Value="#2C3354"/></Trigger></ControlTemplate.Triggers>
                            </ControlTemplate></Setter.Value></Setter>
                        </Style></ListBox.ItemContainerStyle>
                    </ListBox>
                </StackPanel>
                <TextBlock Grid.Row="3" Text="配置自动保存在本机" Foreground="#626B87" FontSize="11"/>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="34,28,34,28">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Text="全部资源" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock x:Name="CountText" Text="集中管理你的项目入口" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="导入" Height="36" Padding="11,0" Background="#E8EAF0" Foreground="#555E70" Click="Import_Click"/>
                    <Button Content="导出" Height="36" Padding="11,0" Margin="6,0,0,0" Background="#E8EAF0" Foreground="#555E70" Click="Export_Click"/>
                    <TextBox x:Name="SearchBox" Width="200" Height="36" Margin="8,0,0,0" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" ToolTip="搜索名称、路径或分类"/>
                    <Button Content="＋ 新增资源" Height="36" Padding="14,0" VerticalAlignment="Center" Margin="12,0,0,0" Background="{StaticResource AccentBrush}" Foreground="White" Click="Add_Click"/>
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Background="#E8EAF1" Height="1" Margin="0,22,0,18"/>
            <ListBox Grid.Row="2" x:Name="ItemsList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="ItemsList_MouseDoubleClick" PreviewMouseRightButtonDown="ItemsList_PreviewMouseRightButtonDown" AllowDrop="True" PreviewMouseLeftButtonDown="ItemsList_PreviewMouseLeftButtonDown" PreviewMouseMove="ItemsList_PreviewMouseMove" DragOver="ItemsList_DragOver" DragLeave="ItemsList_DragLeave" Drop="ItemsList_Drop">
                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.GroupStyle><GroupStyle>
                    <GroupStyle.HeaderTemplate><DataTemplate><StackPanel Margin="0,8,0,12"><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" Foreground="#31394D"/><Border Height="1" Background="#E5E7ED" Margin="0,8,0,0"/></StackPanel></DataTemplate></GroupStyle.HeaderTemplate>
                    <GroupStyle.Panel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></GroupStyle.Panel>
                </GroupStyle></ListBox.GroupStyle>
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Margin" Value="0,0,16,16"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Card" Width="285" Height="112" Background="{Binding CardBackground}" CornerRadius="12" BorderBrush="{Binding Accent}" BorderThickness="1" Padding="15">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderThickness" Value="3"/><Setter TargetName="Card" Property="BorderBrush" Value="#111827"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#111827"/><Setter TargetName="Card" Property="BorderThickness" Value="3"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate>
                    <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" CornerRadius="10" Background="White" BorderBrush="{Binding Accent}" BorderThickness="1" VerticalAlignment="Top"><TextBlock Text="{Binding Icon}" FontSize="17" Foreground="{Binding Accent}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}"/><TextBlock Text="{Binding KindLabel}" Foreground="#7A8294" FontSize="11" Margin="0,5,0,0"/></StackPanel>
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="目录" Padding="9,4" Margin="0,0,6,0" Visibility="{Binding ShowDirectoryButton, Converter={StaticResource BoolToVisibility}}" Click="OpenFolder_Click"/>
                            <Button Content="bin" Padding="9,4" Margin="0,0,6,0" Visibility="{Binding ShowBinButton, Converter={StaticResource BoolToVisibility}}" Click="OpenBin_Click"/>
                            <Button Content="打开" Padding="10,4" Background="{Binding Accent}" Foreground="White" Click="Open_Click"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyText" Grid.Row="2" Text="没有找到资源&#x0a;点击右上角添加第一个入口" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#9097A8" FontSize="14" Visibility="Collapsed"/>
            <TextBlock Grid.Row="3" Text="提示：可拖入文件或文件夹；拖动卡片可插入新位置，右键卡片查看更多操作。" Foreground="#9299A8" FontSize="11" Margin="0,10,0,0"/>
        </Grid>
    </Grid>
</Window>
