<Window x:Class="WorkbenchLauncher.EditItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="资源配置" Width="570" Height="650" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#F6F7FA" FontFamily="Microsoft YaHei UI">
    <Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="资源配置" FontSize="24" FontWeight="Bold" Foreground="#182033"/><TextBlock Text="添加一个工作入口" Foreground="#7A8294" Margin="0,5,0,0"/></StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,24,0,20" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="名称"/><TextBox x:Name="NameBox" Margin="0,7,0,16"/>
                <TextBlock Text="类型"/><ComboBox x:Name="KindBox" Margin="0,7,0,16" Padding="8" SelectionChanged="KindBox_SelectionChanged"/>
                <TextBlock Text="所属分类"/><TextBox x:Name="ProjectBox" Margin="0,7,0,16"/>
                <TextBlock x:Name="TargetLabel" Text="目标路径或网址"/><Grid Margin="0,7,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="TargetBox"/><Button x:Name="BrowseButton" Grid.Column="1" Content="浏览…" Margin="8,0,0,0" Click="Browse_Click"/>
                </Grid>
                <TextBlock Text="启动参数（可选）"/><TextBox x:Name="ArgumentsBox" Margin="0,7,0,16"/>
                <TextBlock Text="工作目录（可选）"/><Grid Margin="0,7,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="WorkingDirectoryBox"/><Button Grid.Column="1" Content="浏览…" Margin="8,0,0,0" Click="BrowseWorking_Click"/>
                </Grid>
                <CheckBox x:Name="FavoriteBox" Content="添加到收藏"/>
                <Border Background="#EEF0FF" CornerRadius="8" Padding="12" Margin="0,18,0,0"><TextBlock x:Name="HintText" Text="双击卡片将使用 Windows 默认程序打开。" Foreground="#515BB9" TextWrapping="Wrap"/></Border>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" Background="#E8EAF0" Foreground="#555E70" Click="Cancel_Click"/><Button Content="保存" Background="#5B67F1" Foreground="White" Margin="10,0,0,0" Click="Save_Click"/></StackPanel>
    </Grid>
</Window>
